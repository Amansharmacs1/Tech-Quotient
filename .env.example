# ==========================================
# TECHQUOTIENT - ENVIRONMENT VARIABLES TEMPLATE
# ==========================================
# This file lists all the environment variables needed for both the Backend and Frontend.
# You can duplicate this file into backend/.env and frontend/.env and fill in the values.

# ------------------------------------------
# BACKEND CONFIGURATION (place in backend/.env)
# ------------------------------------------
# Server Port (Default: 5001)
PORT=5001

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/techquotient

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_key_here

# Gemini / Google AI API Key for TechBot Mentor
AI_API_KEY=your_gemini_api_key_here

# EmailJS Configuration (for email notifications)
EMAILJS_SERVICE_ID=your_service_id_here
EMAILJS_TEMPLATE_ID=your_template_id_here
EMAILJS_PUBLIC_KEY=your_public_key_here
EMAILJS_PRIVATE_KEY=your_private_key_here

# Judge0 Code Execution API (Optional)
# If omitted, the server will fallback to local child_process execution for JS and Python.
JUDGE0_API_KEY=your_judge0_api_key_here
JUDGE0_URL=https://judge0-ce.p.rapidapi.com


# ------------------------------------------
# FRONTEND CONFIGURATION (place in frontend/.env)
# ------------------------------------------
# Backend API Base URL
VITE_API_BASE_URL=http://localhost:5001/api

# EmailJS Public Variables (for client-side triggers if used)
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
